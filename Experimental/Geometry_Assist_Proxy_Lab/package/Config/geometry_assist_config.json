{
  "schema": "ConceptGhost.GeometryAssistDiagnostic.Config.v5",
  "runtime_root": "%LOCALAPPDATA%\\ConceptGhost-GeometryAssistDiagnostic",
  "outputs_root": "%LOCALAPPDATA%\\ConceptGhost-GeometryAssistDiagnostic\\Outputs",
  "hardware_target": "RTX 2080 Ti 11GB",
  "python": {
    "version": "3.10.11",
    "embed_url": "https://www.python.org/ftp/python/3.10.11/python-3.10.11-embed-amd64.zip"
  },
  "models": {
    "base": {
      "repo_id": "stabilityai/stable-diffusion-xl-base-1.0",
      "subdir": "Models/sdxl_base"
    },
    "controlnet": {
      "repo_id": "diffusers/controlnet-canny-sdxl-1.0-small",
      "subdir": "Models/controlnet_canny_sdxl_small"
    },
    "ip_adapter": {
      "repo_id": "h94/IP-Adapter",
      "subdir": "Models/ip_adapter",
      "subfolder": "sdxl_models",
      "weight_name": "ip-adapter_sdxl_vit-h.safetensors",
      "image_encoder_folder": "models/image_encoder",
      "image_encoder_family": "OpenCLIP-ViT-H-14",
      "image_encoder_projection_dim": 1024,
      "pairing_contract": "SDXL_VIT_H_1024"
    }
  },
  "defaults": {
    "profile": "GEOMETRY_ASSIST_MOGE_MASTER",
    "max_dimension": 1024,
    "strength": 0.24,
    "controlnet_scale": 0.95,
    "ip_adapter_scale": 0.8,
    "guidance_scale": 4,
    "steps": 24,
    "seed": 1701,
    "canny_low": 100,
    "canny_high": 200,
    "jpeg_quality": 95,
    "prompt_max_tokens": 77,
    "control_hint_alignment": "EXACT_WORKING_SIZE",
    "prompt_contract": "BOTH_SDXL_CLIP_TOKENIZERS",
    "prompt_intent": "MONOCULAR_GEOMETRY_READABILITY"
  },
  "prompt": "Geometry-assist proxy for monocular 3D estimation. Preserve camera, framing, perspective, composition, silhouettes, positions, proportions, architecture, openings, and object layout. Reduce painterly ambiguity; clarify planes, occlusions, materials, contact shadows, depth layering, and neutral readable lighting.",
  "negative_prompt": "changed camera, changed FOV, crop, fisheye, moved objects, changed proportions, warped architecture, added or removed objects, new openings, hallucinated structures, cinematic relighting, fog, bloom, painterly abstraction, blurred boundaries, scene redesign, text, watermark",
  "host_policy": {
    "shared_comfy_mutation": "FORBIDDEN",
    "shared_python_pip_install": "FORBIDDEN",
    "shared_model_install": "FORBIDDEN",
    "official_pipeline_mutation": "FORBIDDEN",
    "allowed_write_root": "%LOCALAPPDATA%\\ConceptGhost-GeometryAssistDiagnostic"
  }
}

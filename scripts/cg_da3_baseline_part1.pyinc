#!/usr/bin/env python3
"""ConceptGhost Stage 4 — protected DA3 baseline installer.

Safety model:
- preserve every existing custom-node project except the explicitly managed DA3 target;
- preserve every existing Python package version;
- pin the public DA3 node pack when ConceptGhost creates it;
- reuse a pre-existing upstream DA3 checkout without checkout/reset/update;
- install only missing host bridge packages after a pip resolver dry-run proves additions-only;
- materialize DA3's isolated environment with a targeted ``comfy-env install --dir`` call;
- never run the node pack's global ``install.py`` path;
- keep upstream workflow JSON files verbatim when copying references.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.metadata as importlib_metadata
import importlib.util
import json
import os
import re
import shutil
import subprocess
import tempfile
from pathlib import Path
from typing import Any, Iterable

try:
    from .cg_bootstrap import atomic_write_json, atomic_write_text, path_size, sha256_file, utc_now
except ImportError:  # direct execution
    from cg_bootstrap import atomic_write_json, atomic_write_text, path_size, sha256_file, utc_now

DEFAULT_PROJECT_ROOT = Path(r"C:\ConceptGhost")
DA3_REPO_URL = "https://github.com/PozzettiAndrea/ComfyUI-DepthAnythingV3.git"
DA3_PINNED_COMMIT = "20ef6c8ccf8d57a0ad6f6fa7031739eb8489f2a4"
DA3_DIRNAME = "ComfyUI-DepthAnythingV3"
DA3_ENV_NAME = "depthanythingv3-nodes"
COMFY_ENV_VERSION = "0.3.89"
COMFY_3D_VIEWERS_VERSION = "0.2.44"
REFERENCE_WORKFLOWS = ("advanced.json", "advanced_3d.json", "bas_relief.json")

PROTECTED_PACKAGES = {
    "torch",
    "torchvision",
    "numpy",
    "kornia",
    "transformers",
    "xformers",
    "triton",
    "geocalib",
    "opencv-python",
    "opencv-contrib-python",
    "opencv-python-headless",
    "opencv-contrib-python-headless",
    "comfyui-frontend-package",
    "comfyui-workflow-templates",
    "comfy-kitchen",
    "comfy-aimdo",
}
REQUIRED_PROTECTED = {"torch", "torchvision", "numpy", "kornia"}
BRIDGE_REQUIREMENTS = {
    "comfy-env": COMFY_ENV_VERSION,
    "comfy-3d-viewers": COMFY_3D_VIEWERS_VERSION,
}


def _norm_name(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name.strip().lower())


def _norm_remote(url: str | None) -> str:
    if not url:
        return ""
    text = url.strip().replace("\\", "/")
    if text.endswith(".git"):
        text = text[:-4]
    return text.rstrip("/").lower()


def parse_freeze(text: str) -> dict[str, str]:
    out: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if " @ " in line:
            name = line.split(" @ ", 1)[0].strip()
        elif "==" in line:
            name = line.split("==", 1)[0].strip()
        elif line.startswith("-e ") and "#egg=" in line:
            name = line.rsplit("#egg=", 1)[1].strip()
        else:
            name = line.split("[", 1)[0].split("=", 1)[0].strip()
        if name:
            out[_norm_name(name)] = line
    return out


def compare_freeze_maps(
    before: dict[str, str], after: dict[str, str], *, allowed_additions: Iterable[str]
) -> dict[str, Any]:
    allowed = {_norm_name(x) for x in allowed_additions}
    changed = {
        k: {"before": before[k], "after": after[k]}
        for k in sorted(set(before) & set(after))
        if before[k] != after[k]
    }
    removed = {k: before[k] for k in sorted(set(before) - set(after))}
    added = {k: after[k] for k in sorted(set(after) - set(before))}
    allowed_added = {k: v for k, v in added.items() if k in allowed}
    unexpected_added = {k: v for k, v in added.items() if k not in allowed}
    return {
        "safe": not changed and not removed and not unexpected_added,
        "changed": changed,
        "removed": removed,
        "allowed_added": allowed_added,
        "unexpected_added": unexpected_added,
    }


def _tree_fingerprint(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"exists": False, "files": 0, "bytes": 0, "fingerprint": None}
    h = hashlib.sha256()
    files = 0
    total = 0
    for p in sorted((x for x in path.rglob("*") if x.is_file()), key=lambda x: x.as_posix().lower()):
        try:
            st = p.stat()
        except OSError:
            continue
        rel = p.relative_to(path).as_posix()
        files += 1
        total += st.st_size
        h.update(rel.encode("utf-8", errors="surrogatepass"))
        h.update(b"\0")
        h.update(str(st.st_size).encode("ascii"))
        h.update(b"\0")
        h.update(str(st.st_mtime_ns).encode("ascii"))
        h.update(b"\n")
    return {"exists": True, "files": files, "bytes": total, "fingerprint": h.hexdigest()}


def snapshot_protected_custom_nodes(custom_nodes_root: Path) -> dict[str, dict[str, Any]]:
    root = Path(custom_nodes_root)
    if not root.is_dir():
        return {}
    excluded = {"atlas-camera", DA3_DIRNAME.lower()}
    result: dict[str, dict[str, Any]] = {}
    for child in sorted(root.iterdir(), key=lambda x: x.name.lower()):
        if child.name.lower() in excluded:
            continue
        if child.is_dir():
            result[child.name] = _tree_fingerprint(child)
        elif child.is_file():
            result[child.name] = _tree_fingerprint(child)
    return result


def compare_protected_custom_node_snapshots(before: dict[str, Any], after: dict[str, Any]) -> dict[str, Any]:
    added = {k: after[k] for k in sorted(set(after) - set(before))}
    removed = {k: before[k] for k in sorted(set(before) - set(after))}
    changed = {
        k: {"before": before[k], "after": after[k]}
        for k in sorted(set(before) & set(after))
        if before[k] != after[k]
    }
    return {"safe": not added and not removed and not changed, "added": added, "removed": removed, "changed": changed}


def build_install_plan_from_probe(probe: dict[str, Any], repo_state: dict[str, Any]) -> dict[str, Any]:
    packages = {_norm_name(k): v for k, v in (probe.get("packages") or {}).items()}
    modules = probe.get("modules") or {}
    blockers: list[str] = []
    reuse: list[dict[str, Any]] = []
    bridge_requirements: list[str] = []

    for name in sorted(REQUIRED_PROTECTED):
        if not packages.get(name):
            blockers.append(
                f"Required protected package '{name}' is missing. Stage 4 will not install or replace protected packages."
            )

    for component, wanted in BRIDGE_REQUIREMENTS.items():
        installed = packages.get(component)
        module_key = component.replace("-", "_")
        importable = bool(modules.get(module_key))
        if installed is None:
            bridge_requirements.append(f"{component}=={wanted}")
        elif str(installed) != wanted:
            blockers.append(
                f"Existing {component} {installed} differs from the upstream-required {wanted}; Stage 4 will not overwrite it."
            )
        elif not importable:
            blockers.append(
                f"Existing {component} {installed} is not importable; Stage 4 will not overwrite a broken existing installation."
            )
        else:
            reuse.append({"component": component, "version": installed, "action": "reuse_existing"})

    target = repo_state.get("target")
    if not repo_state.get("exists"):
        repo_plan = {
            "action": "clone",
            "target": target,
            "repo_url": DA3_REPO_URL,
            "pinned_commit": DA3_PINNED_COMMIT,
        }
    else:
        remote = repo_state.get("remote_url")
        if not repo_state.get("is_git") or _norm_remote(remote) != _norm_remote(DA3_REPO_URL):
            blockers.append(
                "The existing DA3 target is not the expected upstream Git remote; Stage 4 will not replace or overwrite it."
            )
            repo_plan = {"action": "blocked", "target": target, "actual_remote": remote}
        else:
            missing = [x for x in REFERENCE_WORKFLOWS if x not in set(repo_state.get("workflows_present") or [])]
            if missing:
                blockers.append(
                    "Existing upstream DA3 checkout is missing required reference workflows: " + ", ".join(missing)
                )
            repo_plan = {
                "action": "reuse_existing_untouched",
                "target": target,
                "repo_url": remote,
                "actual_commit": repo_state.get("commit"),
                "pinned_commit_for_new_installs": DA3_PINNED_COMMIT,
            }

    return {
        "blockers": blockers,
        "repo": repo_plan,
        "bridge_requirements": bridge_requirements,
        "reuse": reuse,
        "protected_packages": sorted(PROTECTED_PACKAGES),
        "protected_changes_planned": [],
        "reference_workflows": list(REFERENCE_WORKFLOWS),
        "policy": {
            "no_existing_package_replacement": True,
            "no_other_custom_node_writes": True,
            "preserve_preexisting_da3_checkout": True,
            "targeted_comfy_env_only": True,
            "no_global_install_py": True,
            "reference_workflows_verbatim": True,
        },
    }


def assess_resolver_report(installed_versions: dict[str, str], report: dict[str, Any]) -> dict[str, Any]:
    installed = {_norm_name(k): str(v) for k, v in installed_versions.items() if v is not None}
    additions: dict[str, str] = {}
    existing_changes: dict[str, dict[str, str]] = {}
    malformed: list[dict[str, Any]] = []
    for item in report.get("install") or []:
        meta = item.get("metadata") or {}
        name = _norm_name(str(meta.get("name") or ""))
        version = str(meta.get("version") or "")
        if not name or not version:
            malformed.append(item)
            continue
        current = installed.get(name)
        if current is None:
            if name in PROTECTED_PACKAGES:
                existing_changes[name] = {"before": "missing/protected", "after": version}
            else:
                additions[name] = version
        elif current != version:
            existing_changes[name] = {"before": current, "after": version}
    return {
        "safe": not existing_changes and not malformed,
        "allowed_additions": additions,
        "existing_changes": existing_changes,
        "malformed_entries": malformed,
    }


def build_isolated_workspace_command(python_exe: Path, shadow_comfyui: Path) -> list[str]:
    """Build only the DA3 env in a project-owned comfy-env workspace.

    We deliberately bypass comfy-env 0.3.89's plugin install() entry point because
    that version performs a workspace-wide install across every discovered node pack.
    The subprocess receives COMFY_ENV_ROOT pointing at the ConceptGhost cache, and
    the shadow ComfyUI contains only DA3's isolation config.
    """
    code = (
        "from pathlib import Path; "
        "from comfy_env.install.workspace import install_workspace; "
        f"p=Path({str(shadow_comfyui)!r}); "
        "r=install_workspace(p, dry_run=False); "
        "raise SystemExit(0 if r is not None else 2)"
    )
    return [str(python_exe), "-c", code]


def isolated_env_paths(project_root: Path, global_workspace: Path) -> tuple[Path, Path]:
    project_env = Path(project_root) / "cache" / "da3-comfy-env" / ".pixi" / "envs" / DA3_ENV_NAME
    runtime_link = Path(global_workspace) / ".pixi" / "envs" / DA3_ENV_NAME
    return project_env, runtime_link


def make_safe_shadow_config(text: str) -> str:
    """Remove optional CUDA acceleration from the staging config only.

    The upstream DA3 workflow keeps attention=auto and publicly supports SDPA.
    Removing flash_attn/sageattention from the *shadow build config* forces the
    isolated env to retain the host torch/CUDA ABI instead of comfy-env 0.3.89
    falling back to a different torch family. The upstream checkout is untouched.
    """
    lines = text.splitlines()
    out: list[str] = []
    skipping = False
    for line in lines:
        stripped = line.strip()
        if stripped == "[cuda]":
            skipping = True
            continue
        if skipping and stripped.startswith("[") and stripped.endswith("]"):
            skipping = False
        if not skipping:
            out.append(line)
    return "\n".join(out).rstrip() + "\n"

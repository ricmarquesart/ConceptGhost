def _prepare_shadow_comfyui(*, comfy_root: Path, da3_root: Path, project_root: Path) -> Path:
    shadow = Path(project_root) / "cache" / "da3-shadow-comfyui"
    if shadow.exists():
        shutil.rmtree(shadow)
    (shadow / "custom_nodes" / DA3_DIRNAME / "nodes").mkdir(parents=True, exist_ok=True)
    (shadow / "comfy").mkdir(parents=True, exist_ok=True)
    (shadow / "main.py").write_text("# ConceptGhost Stage 4 shadow ComfyUI marker\n", encoding="utf-8")
    source_cfg = Path(da3_root) / "nodes" / "comfy-env.toml"
    if not source_cfg.is_file():
        raise RuntimeError(f"DA3 isolation config missing: {source_cfg}")
    safe_cfg = make_safe_shadow_config(source_cfg.read_text(encoding="utf-8"))
    (shadow / "custom_nodes" / DA3_DIRNAME / "nodes" / "comfy-env.toml").write_text(safe_cfg, encoding="utf-8")
    # comfy-env reads ComfyUI requirements while generating its workspace. Copy
    # requirements*.txt only; no executable code from other custom nodes enters the shadow.
    for req in Path(comfy_root).glob("requirements*.txt"):
        if req.is_file():
            shutil.copy2(req, shadow / req.name)
    return shadow


def _same_resolved_path(a: Path, b: Path) -> bool:
    try:
        return os.path.normcase(str(a.resolve())) == os.path.normcase(str(b.resolve()))
    except OSError:
        return False


def _runtime_link_state(runtime_link: Path, project_env: Path) -> dict[str, Any]:
    exists = os.path.lexists(str(runtime_link))
    state: dict[str, Any] = {"exists": exists, "path": str(runtime_link), "expected_target": str(project_env)}
    if not exists:
        state["action"] = "create_additive_link"
        return state
    state["actual_target"] = str(runtime_link.resolve())
    if _same_resolved_path(runtime_link, project_env):
        state["action"] = "reuse_existing_link"
        state["safe"] = True
    else:
        state["action"] = "blocked_existing_path"
        state["safe"] = False
    return state


def _create_runtime_link(runtime_link: Path, project_env: Path) -> str:
    runtime_link.parent.mkdir(parents=True, exist_ok=True)
    state = _runtime_link_state(runtime_link, project_env)
    if state.get("action") == "reuse_existing_link":
        return "reuse_existing_link"
    if state.get("action") == "blocked_existing_path":
        raise RuntimeError(f"DA3 runtime env path already exists and is not ConceptGhost-owned: {runtime_link}")
    if not project_env.is_dir():
        raise RuntimeError(f"Project-owned DA3 isolated environment was not materialized: {project_env}")
    if os.name == "nt":
        cp = _run(["cmd.exe", "/d", "/c", "mklink", "/J", str(runtime_link), str(project_env)], timeout=120)
        if cp.returncode != 0:
            raise RuntimeError(f"Failed to create additive DA3 runtime junction: {(cp.stderr or cp.stdout)[-3000:]}")
    else:
        runtime_link.symlink_to(project_env, target_is_directory=True)
    if not _same_resolved_path(runtime_link, project_env):
        raise RuntimeError("DA3 runtime link verification failed")
    return "create_additive_link"


# Runtime helpers below are intentionally small wrappers around the tested planning logic.

def _load_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def _run(cmd: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None, timeout: int = 3600) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        env=env,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
    )


def _resolve_environment(project_root: Path) -> tuple[Path, Path]:
    inv_path = project_root / "manifests" / "preinstall_inventory.json"
    if not inv_path.is_file():
        raise RuntimeError(f"Inventory not found: {inv_path}. Run INVENTORY.bat first.")
    inv = _load_json(inv_path)
    selected = inv.get("comfyui", {}).get("selected") or {}
    comfy = Path(selected.get("root") or "")
    py = Path(selected.get("python_executable") or "")
    if not (comfy / "main.py").is_file():
        raise RuntimeError("ComfyUI root from inventory is invalid.")
    if not py.is_file():
        raise RuntimeError("ComfyUI Python from inventory is invalid.")
    return comfy, py


def _probe_packages(python_exe: Path) -> dict[str, Any]:
    names = sorted(PROTECTED_PACKAGES | set(BRIDGE_REQUIREMENTS))
    code = r'''
import importlib.metadata as md, importlib.util, json, sys
names=%r
packages={}
for name in names:
    try: packages[name]=md.version(name)
    except md.PackageNotFoundError: packages[name]=None
mods={}
for name in ["comfy_env", "comfy_3d_viewers"]:
    try: mods[name]=importlib.util.find_spec(name) is not None
    except Exception: mods[name]=False
print(json.dumps({"python":sys.version.split()[0],"executable":sys.executable,"packages":packages,"modules":mods}))
''' % names
    cp = _run([str(python_exe), "-c", code], timeout=120)
    if cp.returncode != 0:
        raise RuntimeError(f"environment probe failed: {cp.stderr[-4000:]}")
    return json.loads(cp.stdout.strip().splitlines()[-1])


def _pip_freeze(python_exe: Path) -> tuple[str, dict[str, str]]:
    cp = _run([str(python_exe), "-m", "pip", "freeze"], timeout=180)
    if cp.returncode != 0:
        raise RuntimeError(f"pip freeze failed: {cp.stderr[-4000:]}")
    return cp.stdout, parse_freeze(cp.stdout)


def _installed_versions(python_exe: Path) -> dict[str, str]:
    code = r'''
import importlib.metadata as md, json
out={}
for d in md.distributions():
    name=d.metadata.get("Name")
    if name: out[name]=d.version
print(json.dumps(out))
'''
    cp = _run([str(python_exe), "-c", code], timeout=120)
    if cp.returncode != 0:
        raise RuntimeError(f"distribution inventory failed: {cp.stderr[-4000:]}")
    return json.loads(cp.stdout.strip().splitlines()[-1])


def _git_output(args: list[str], cwd: Path) -> str | None:
    cp = _run(["git", *args], cwd=cwd, timeout=60)
    return cp.stdout.strip() if cp.returncode == 0 else None


def inspect_repo(target: Path) -> dict[str, Any]:
    state: dict[str, Any] = {"exists": target.exists(), "target": str(target)}
    if not target.exists():
        return state
    state["is_git"] = (target / ".git").exists()
    state["remote_url"] = _git_output(["config", "--get", "remote.origin.url"], target) if state["is_git"] else None
    state["commit"] = _git_output(["rev-parse", "HEAD"], target) if state["is_git"] else None
    workflows = target / "workflows"
    state["workflows_present"] = [x for x in REFERENCE_WORKFLOWS if (workflows / x).is_file()]
    return state


def _resolver_preflight(python_exe: Path, requirements: list[str], temp_dir: Path) -> tuple[dict[str, Any], str, int]:
    report_path = temp_dir / "pip_resolver_report.json"
    cmd = [
        str(python_exe), "-m", "pip", "install",
        "--dry-run", "--report", str(report_path), "--no-cache-dir", "--only-binary=:all:",
        *requirements,
    ]
    cp = _run(cmd, timeout=900)
    report = _load_json(report_path) if report_path.is_file() else {"install": []}
    text = (cp.stdout or "") + ("\n" + cp.stderr if cp.stderr else "")
    return report, text, cp.returncode


def _clone_pinned(target: Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        raise RuntimeError(f"DA3 target already exists: {target}")
    with tempfile.TemporaryDirectory(prefix="cg_da3_clone_", dir=str(target.parent)) as td:
        tmp = Path(td) / DA3_DIRNAME
        cp = _run(["git", "clone", DA3_REPO_URL, str(tmp)], timeout=1800)
        if cp.returncode != 0:
            raise RuntimeError(f"DA3 clone failed: {(cp.stderr or cp.stdout)[-5000:]}")
        cp = _run(["git", "checkout", "--detach", DA3_PINNED_COMMIT], cwd=tmp, timeout=180)
        if cp.returncode != 0:
            raise RuntimeError(f"DA3 checkout failed: {(cp.stderr or cp.stdout)[-5000:]}")
        actual = _git_output(["rev-parse", "HEAD"], tmp)
        if actual != DA3_PINNED_COMMIT:
            raise RuntimeError(f"DA3 checkout mismatch: expected {DA3_PINNED_COMMIT}, got {actual}")
        shutil.move(str(tmp), str(target))


def _copy_reference_workflows(repo_root: Path, project_root: Path) -> list[dict[str, Any]]:
    dest_root = project_root / "workflows" / "reference" / "da3"
    dest_root.mkdir(parents=True, exist_ok=True)
    results = []
    for name in REFERENCE_WORKFLOWS:
        source = repo_root / "workflows" / name
        if not source.is_file():
            raise RuntimeError(f"Required upstream DA3 workflow missing: {source}")
        dest = dest_root / name
        data = source.read_bytes()
        if dest.exists() and dest.read_bytes() != data:
            raise RuntimeError(f"Reference workflow already exists with different content; refusing overwrite: {dest}")
        if not dest.exists():
            dest.write_bytes(data)
            action = "copy"
        else:
            action = "reuse_identical"
        results.append({"name": name, "source": str(source), "path": str(dest), "action": action, "sha256": sha256_file(dest)})
    return results


def _workspace_paths() -> tuple[Path, Path]:
    local = os.environ.get("LOCALAPPDATA")
    if os.name == "nt" and local:
        root = Path(local) / "Programs" / "comfy-env"
    else:
        root = Path.home() / ".ce"
    pixi_home = Path.home() / ".comfy-env"
    return root, pixi_home


def _snapshot_workspace_envs(workspace_root: Path) -> dict[str, Any]:
    envs = workspace_root / ".pixi" / "envs"
    if not envs.is_dir():
        return {}
    return {child.name: _tree_fingerprint(child) for child in sorted(envs.iterdir()) if child.is_dir()}


def _compare_workspace_existing(before: dict[str, Any], after: dict[str, Any]) -> dict[str, Any]:
    removed = {k: before[k] for k in sorted(set(before) - set(after))}
    changed = {
        k: {"before": before[k], "after": after[k]}
        for k in sorted(set(before) & set(after)) if before[k] != after[k]
    }
    added = {k: after[k] for k in sorted(set(after) - set(before))}
    return {"safe_existing": not removed and not changed, "removed": removed, "changed": changed, "added": added}


def _exact_addition_specs(additions: dict[str, str]) -> list[str]:
    return [f"{name}=={version}" for name, version in sorted(additions.items())]


def _install_additions(python_exe: Path, additions: dict[str, str]) -> str:
    if not additions:
        return "No host bridge additions required."
    specs = _exact_addition_specs(additions)
    cp = _run([
        str(python_exe), "-m", "pip", "install", "--no-deps", "--no-cache-dir", "--only-binary=:all:", *specs
    ], timeout=1800)
    text = (cp.stdout or "") + ("\n" + cp.stderr if cp.stderr else "")
    if cp.returncode != 0:
        raise RuntimeError(f"Host bridge additive install failed:\n{text[-7000:]}")
    return text


def _bridge_import_probe(python_exe: Path) -> dict[str, Any]:
    code = r'''
import json
out={}
try:
 import comfy_env, comfy_3d_viewers
 out={"ok":True,"comfy_env":getattr(comfy_env,"__version__",None),"comfy_3d_viewers":getattr(comfy_3d_viewers,"__version__",None)}
except Exception as e:
 out={"ok":False,"error":type(e).__name__+": "+str(e)}
print(json.dumps(out))
'''
    cp = _run([str(python_exe), "-c", code], timeout=120)
    if cp.returncode != 0:
        return {"ok": False, "error": (cp.stderr or cp.stdout)[-4000:]}
    try:
        return json.loads(cp.stdout.strip().splitlines()[-1])
    except Exception:
        return {"ok": False, "error": "unreadable bridge import probe", "stdout": cp.stdout[-3000:]}
